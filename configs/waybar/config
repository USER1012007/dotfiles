{
    "layer": "top",
    "height": 32,
    "margin-top": 4,
    "margin-left": 4,
    "margin-right": 4,
    "spacing": 0,
    "reload_style_on_change": false,

    "modules-left": [
        "network",
        "wlr/taskbar"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/recorder",
        "keyboard-state", 
        "pulseaudio", 
        "battery"
    ],

    "custom/recorder": {
      "format": "{}",
      "exec": "pgrep -x wf-recorder >/dev/null && echo '{\"text\":\" \",\"class\":\"recording\",\"tooltip\":\"Detener grabación\"}' || echo '{\"text\":\" \",\"class\":\"stopped\",\"tooltip\":\"Grabar pantalla\"}'",
      "return-type": "json",
      "interval": "once",
      "signal": 8,
      "on-click": "~/dotfiles/scripts/wayland/record-toggle.sh"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "tooltip-format": "{title} | {app_id}",
        "on-click-middle": "close",
        "on-click-right": "fullscreen"
    },

    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },

    // "clock": {
    //     "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    //     "format": "{:%e %B %I:%M %p}"
    // },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%e %B %I:%M %p}",
        "on-click": "gsimplecal",
        "tooltip": false
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󱐋",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "format-wifi": " ",
        "format-ethernet": "󰈀",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": " ",
        "format-disconnected": "󰖪",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": "󰝟 {icon}",
        "format-muted": "󰝟",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "foot wiremix"
    }
}
